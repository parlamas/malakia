generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  username      String    @unique
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  tokenVersion  Int       @default(0)
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  posts               Post[]            @relation("PostAuthor")
  contests            Contest[]         @relation("ContestAuthor")
  moderatedPosts      Post[]            @relation("PostLanguageModerator")
  auditLogEntries     AuditLogEntry[]   @relation("AuditActor")
  scaleSuggestions    ScaleSuggestion[] @relation("ScaleSuggestionAuthor")
  reactions           Reaction[]        @relation("ReactionAuthor")
  reports             Report[]          @relation("ReportAuthor")
  reviewedReports     Report[]          @relation("ReportReviewer")
  adminJudgments      AdminJudgment[]   @relation("AdminJudgmentAuthor")
  moderatedSuggestions ScaleSuggestion[] @relation("SuggestionLanguageModerator")
  userReportsFiled     UserReport[]      @relation("UserReportAuthor")
  userReportsReceived  UserReport[]      @relation("UserReportSubject")
  userReportsReviewed  UserReport[]      @relation("UserReportReviewer")
}

// Account, Session, VerificationToken models stay the same
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  ip         String?

  @@index([identifier])
}

model PasswordResetRequest {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier])
}

model PasswordAuditLog {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------------- Malakia political ethics barometer ----------------

enum SubjectType {
  PERSON
  INSTITUTION
  ORGANIZATION
  BUSINESS
  NATION
  REGIME
  ADMINISTRATION
  PRACTICE
  TRADITION
  IDEOLOGY
}

enum PersonaCategory {
  ELECTED_OFFICIAL
  APPOINTED_OFFICIAL
  JOURNALIST
  GOVERNMENT_MEMBER // judiciary, legislature, law enforcement
  HISTORICAL_FIGURE // documented figure from any era, not scoped to a tenure
}

enum Axis {
  CALLOUS
  CIVIC
}

enum PostStatus {
  PENDING           // language-moderation queue
  PUBLISHED
  REJECTED_LANGUAGE
  REMOVED           // post-publication takedown (legal notice, etc.)
}

enum VerificationStatus {
  UNVERIFIED
  ADMIN_CONFIRMED
  DISPUTED
}

enum DisputeType {
  DENIES_OCCURRED
  DISPUTES_CLASSIFICATION // "wrong behavior tag"
  DISPUTES_SCOPE          // "not in public capacity / outside tenure"
  PROVIDES_CONTEXT
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

enum JudgmentSide {
  NEGATIVE
  POSITIVE
  ZERO // used only when a judgment is submitted with nothing filled in on either side
}

enum ExtremeBadge {
  UNFORGIVABLE
  IMMORTAL
  HUBRIS
  CELESTIAL
}

model Subject {
  id                  String              @id @default(cuid())
  subjectType         SubjectType

  displayName         String
  description         String?             // general description — used by all non-person types
  disambiguators      String?             // city, org, title — for name collisions

  // PERSON-only fields
  personaCategory     PersonaCategory?
  roleTitle           String?

  roleStartYear       Int?
  roleStartMonth      Int?
  roleStartDay        Int?
  roleStartCirca      Boolean             @default(false)
  roleStartUnknown    Boolean             @default(false)

  roleEndYear         Int?
  roleEndMonth        Int?
  roleEndDay          Int?
  roleEndCirca        Boolean             @default(false)
  roleEndUnknown      Boolean             @default(false)
  stillServing        Boolean             @default(false) // also used by NATION/INSTITUTION/ORG/BUSINESS/REGIME as "still exists/active"

  approximatePeriod   String?             // free text fallback, e.g. "5th century BCE Athens"

  birthYear           Int?
  birthMonth          Int?
  birthDay            Int?
  birthCirca          Boolean             @default(false)
  birthUnknown        Boolean             @default(false)

  isDeceased          Boolean             @default(false)
  deathYear           Int?
  deathMonth          Int?
  deathDay            Int?
  deathCirca          Boolean             @default(false)
  deathUnknown        Boolean             @default(false)

  // Optional free-text context — never a required/structured "country" field,
  // since ethics is being judged, not nationality
  associatedContext   String?             // e.g. jurisdiction for a business, origin for a practice/tradition

  roleEvidenceUrl     String?
  photoUrl            String?
  verificationStatus  VerificationStatus  @default(UNVERIFIED)
extremeBadge        ExtremeBadge?

adminJudgment       AdminJudgment?

  posts               Post[]
  scaleSuggestions    ScaleSuggestion[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([displayName])
  @@index([subjectType])
}

model Post {
  id                            String     @id @default(cuid())
  authorUserId                  String
  author                        User       @relation("PostAuthor", fields: [authorUserId], references: [id])

  subjectId                     String
  subject                       Subject    @relation(fields: [subjectId], references: [id])

  axis                          Axis
  behaviorLabel                 String     // free text — what specifically happened, in the filer's own words

  narrative                     String
  evidenceUrl                   String?

  conductYear                   Int
  conductMonth                  Int?
  conductDay                    Int?
  conductCirca                  Boolean    @default(false)
  conductUnknown                Boolean    @default(false)
  conductEraNote                String?    // free text, e.g. "shortly before his trial"

  publicCapacityJustification   String

  status                        PostStatus @default(PENDING)
  languageModeratedById         String?
  languageModeratedBy           User?      @relation("PostLanguageModerator", fields: [languageModeratedById], references: [id])
  languageModeratedAt           DateTime?
  rejectionReason               String?

  contests                      Contest[]
  reactions                     Reaction[]
  reports                       Report[]
  scaleSuggestions              ScaleSuggestion[] @relation("SuggestionRepliesToPost")
  createdAt                     DateTime   @default(now())

  @@index([subjectId, axis])
}

model Contest {
  id                  String      @id @default(cuid())
  postId              String
  post                Post        @relation(fields: [postId], references: [id])

  contestingUserId    String
  contestingUser      User        @relation("ContestAuthor", fields: [contestingUserId], references: [id])

  disputeType         DisputeType
  justification       String
  createdAt           DateTime    @default(now())

  reactions           Reaction[]
  reports             Report[]
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation("AuditActor", fields: [actorUserId], references: [id])

  action      String   // "post_approved" | "post_rejected_language" | "post_removed" | ...
  targetType  String   // "Post" | "Subject" | "Contest"
  targetId    String
  reason      String?
  createdAt   DateTime @default(now())
}

model ScaleSuggestion {
  id            String   @id @default(cuid())

  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])

  userId        String
  user          User     @relation("ScaleSuggestionAuthor", fields: [userId], references: [id])

  replyToId     String?
  replyTo       ScaleSuggestion?  @relation("SuggestionReplies", fields: [replyToId], references: [id])
  replies       ScaleSuggestion[] @relation("SuggestionReplies")

  replyToPostId String?
  replyToPost   Post?    @relation("SuggestionRepliesToPost", fields: [replyToPostId], references: [id])

  status                PostStatus @default(PENDING)
  languageModeratedById String?
  languageModeratedBy   User?      @relation("SuggestionLanguageModerator", fields: [languageModeratedById], references: [id])
  languageModeratedAt   DateTime?
  rejectionReason       String?

  createdAt     DateTime @default(now())

  entries       SuggestionEntry[]
  reactions     Reaction[]
  reports       Report[]

  @@index([subjectId])
  @@index([status])
}

model SuggestionEntry {
  id            String          @id @default(cuid())
  suggestionId  String
  suggestion    ScaleSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  side          JudgmentSide
  magnitude     Int             // 0-1000
  justification String?
  order         Int             // determines A, B, C... within its side

  createdAt     DateTime        @default(now())
}

model AdminJudgment {
  id            String   @id @default(cuid())

  subjectId     String   @unique
  subject       Subject  @relation(fields: [subjectId], references: [id])

  setByUserId   String
  setBy         User     @relation("AdminJudgmentAuthor", fields: [setByUserId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries       AdminJudgmentEntry[]
}

model AdminJudgmentEntry {
  id            String        @id @default(cuid())
  judgmentId    String
  judgment      AdminJudgment @relation(fields: [judgmentId], references: [id], onDelete: Cascade)

  side          JudgmentSide
  magnitude     Int           // 0-1000
  justification String?
  order         Int           // determines A, B, C... within its side

  createdAt     DateTime      @default(now())
}

model Reaction {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation("ReactionAuthor", fields: [userId], references: [id])

  postId            String?           // optional — a reaction to a suggestion has no single post to anchor to
  post              Post?             @relation(fields: [postId], references: [id])

  scaleSuggestionId String?
  scaleSuggestion   ScaleSuggestion?  @relation(fields: [scaleSuggestionId], references: [id])

  contestId         String?
  contest           Contest?          @relation(fields: [contestId], references: [id])

  body              String            // free text — users write what they want

  createdAt         DateTime          @default(now())

  @@index([postId])
  @@index([scaleSuggestionId])
}

model Report {
  id                String            @id @default(cuid())
  reporterUserId    String
  reporter          User              @relation("ReportAuthor", fields: [reporterUserId], references: [id])

  postId            String            // always required — every report is anchored to a specific post
  post              Post              @relation(fields: [postId], references: [id])

  scaleSuggestionId String?
  scaleSuggestion   ScaleSuggestion?  @relation(fields: [scaleSuggestionId], references: [id])

  contestId         String?
  contest           Contest?          @relation(fields: [contestId], references: [id])

  reason            String
  status            ReportStatus      @default(PENDING)

  reviewedById      String?
  reviewedBy        User?             @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  resolutionNote    String?

  createdAt         DateTime          @default(now())

  @@index([postId])
}

model UserReport {
  id                String       @id @default(cuid())
  reporterUserId    String
  reporter          User         @relation("UserReportAuthor", fields: [reporterUserId], references: [id])

  reportedUserId    String
  reportedUser      User         @relation("UserReportSubject", fields: [reportedUserId], references: [id])

  reason            String
  status            ReportStatus @default(PENDING)

  reviewedById      String?
  reviewedBy        User?        @relation("UserReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  resolutionNote    String?

  createdAt         DateTime     @default(now())

  @@index([reportedUserId])
}