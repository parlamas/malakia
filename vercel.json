{
  "rewrites": [
    {
      "source": "/api/verify-email",
      "destination": "/api/verify-email"
    },
    {
      "source": "/api/auth/verify-email",
      "destination": "/api/auth/verify-email"
    }
  ],
  "headers": [
    {
      "source": "/api/verify-email",
      "headers": [
        { "key": "X-Verify-Endpoint", "value": "real" }
      ]
    },
    {
      "source": "/api/auth/verify-email",
      "headers": [
        { "key": "X-Verify-Endpoint", "value": "redirect" }
      ]
    }
  ]
}
